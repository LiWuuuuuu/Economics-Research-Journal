. global AUDIT_HANDLE `audit'

. global SOURCE_HANDLE `sources'

. do 02_helpers.do

. * 核查键，不自动删除重复或缺失的记录。
. program define check_key
  1.     syntax varlist
  2.     generate byte flag_key_missing = 0
  3.     foreach v of local varlist {
  4.         replace flag_key_missing = 1 if missing(`v')
  5.     }
  6.     tempvar dup
  7.     duplicates tag `varlist', generate(`dup')
  8.     generate byte flag_duplicate_key = `dup'>0
  9.     duplicates report `varlist'
 10. end

. 
. * 报告包括每个字段的Stata缺失、文本None/null等缺失标记及每个质量标记。
. program define table_metrics
  1.     syntax, Table(string) Fields(varlist)
  2.     post $AUDIT_HANDLE ("`table'") ("rows") (_N)
  3.     foreach v of local fields {
  4.         quietly count if missing(`v')
  5.         post $AUDIT_HANDLE ("`table'") ("missing:`v'") (r(N))
  6.         capture confirm string variable `v'
  7.         if !_rc {
  8.             quietly count if inlist(ustrlower(ustrtrim(`v')),"none","null","nan","n/a")
  9.             post $AUDIT_HANDLE ("`table'") ("text_missing_token:`v'") (r(N))
 10.         }
 11.     }
 12.     ds flag_*
 13.     foreach v of varlist `r(varlist)' {
 14.         quietly count if `v'==1
 15.         post $AUDIT_HANDLE ("`table'") ("`v'") (r(N))
 16.     }
 17.     capture confirm numeric variable year
 18.     if !_rc {
 19.         quietly summarize year
 20.         post $AUDIT_HANDLE ("`table'") ("year_min") (r(min))
 21.         post $AUDIT_HANDLE ("`table'") ("year_max") (r(max))
 22.         preserve
 23.             generate byte count_unit=1
 24.             collapse (sum) rows=count_unit flag_*, by(year)
 25.             export delimited using "$OUT/`table'_by_year.csv"
 26.         restore
 27.     }
 28. end

. 
. program define save_review
  1.     args table
  2.     egen byte flag_any=rowmax(flag_*)
  3.     preserve
  4.         keep if flag_any==1
  5.         save "$OUT/`table'_review.dta"
  6.     restore
  7. end

. 
. program define datestring
  1.     syntax varname, Generate(name)
  2.     generate double `generate'=daily(`varlist',"YMD")
  3.     format `generate' %tdCCYY-NN-DD
  4. end

. 
end of do-file

